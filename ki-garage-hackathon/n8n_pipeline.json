      "position": [
        1440,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "// Process each talk from Get New Talks\nfor (const item of $('Get New Talks1').all()) {\n  const talkId = item.json.talk_id;\n  \n  // Get all transcript folders\n  const allFolders = $('List Transcript Folders1').all();\n  \n  // Find folder containing the talk ID\n  const transcriptFolder = allFolders.find(folder => {\n    return folder.json.fileName.includes(`[${talkId}]`);\n  });\n  \n  if (!transcriptFolder) {\n    throw new Error(`No transcript folder found for talk ${talkId}`);\n  }\n  \n  // Construct the transcript file path\n  const transcriptPath = `${transcriptFolder.json.path}/transcript.txt`;\n  \n  return {\n    ...item.json,\n    transcriptPath: transcriptPath\n  };\n}"
      },
      "id": "f7223cc9-5980-4161-bc82-33c03252cb72",
      "name": "Find Transcript Path1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1648,
        384
      ]
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.transcriptPath }}",
        "options": {}
      },
      "id": "aee5fc08-40b0-49c8-8c26-19cf2707ba05",
      "name": "Read Transcript1",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1840,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "// Get data from previous nodes\nconst talkData = $('Find Transcript Path1').item.json;\nconst transcriptContent = $('Read Transcript1').item.json.fileContent || '';\n\n// Try to read metadata file if it exists\nlet metadata = {};\nconst metadataFiles = $('Read Talk Metadata1').all();\nconst metadataFile = metadataFiles.find(file => \n  file.json.fileName.includes(talkData.talk_id)\n);\n\nif (metadataFile && metadataFile.json.fileContent) {\n  try {\n    metadata = JSON.parse(metadataFile.json.fileContent);\n  } catch (e) {\n    console.log('Could not parse metadata');\n  }\n}\n\n// Prepare data for AI\nreturn {\n  talk_id: talkData.talk_id,\n  title: talkData.title || metadata.title || 'Untitled Talk',\n  talk_date: talkData.talk_date,\n  youtube_url: talkData.youtube_url,\n  speakers: metadata.speakers || [],\n  abstract: metadata.abstract || metadata.description || '',\n  track: metadata.track || 'Python',\n  transcript: transcriptContent.substring(0, 3000)\n};"
      },
      "id": "3ce496c1-f9fb-4e9a-9ec8-2d9288eb4849",
